{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agy Credential Manager",
  "version": "0.1.0",
  "identifier": "com.agy.credential-manager",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Agy Credential Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-gl=angle --use-angle=swiftshader --disable-gpu-sandbox"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
